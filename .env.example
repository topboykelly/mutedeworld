# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API (or "API Keys").
# Without these, the store runs in demo mode with the built-in sample products
# and the admin portal shows setup instructions.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key. Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the live address, e.g. https://mutedeworld.com (used for link previews).
# On Vercel this defaults to the project's production domain.
NEXT_PUBLIC_SITE_URL=
